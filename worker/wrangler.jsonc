{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sungwoo-kasa-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "secrets": {
    "required": ["KASA_API_KEY"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "KASA_RELAY", "class_name": "KasaRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["KasaRelay"] }
  ]
}